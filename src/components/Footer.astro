---
const year = new Date().getFullYear();
---

<footer class="border-t border-hairline bg-canvas-inset dark:border-hairline dark:bg-canvas-inset">
  <div class="container-page py-24">
    <div class="flex flex-col gap-16 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm">
        <a href="/" class="flex items-center gap-2 font-semibold tracking-tight text-ink dark:text-ink" aria-label="ScreenCheck home">
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary text-on-primary">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
              <rect x="2" y="3" width="20" height="14" rx="2"></rect>
              <path d="M8 21h8M12 17v4"></path>
            </svg>
          </span>
          <span class="text-lg">Screen<span class="text-link">Check</span></span>
        </a>
        <p class="mt-4 text-base leading-relaxed text-body dark:text-body">
          See your exact screen resolution, scaling and refresh rate — and whether it is set correctly. Free, instant, runs in your browser.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        <div>
          <h2 class="text-caption-mono text-muted dark:text-muted">Tool</h2>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="/#tool" class="text-link hover:text-link-hover">Check my screen</a></li>
            <li><a href="/#how" class="text-link hover:text-link-hover">How it works</a></li>
            <li><a href="/#faq" class="text-link hover:text-link-hover">FAQ</a></li>
          </ul>
        </div>
        <div>
          <h2 class="text-caption-mono text-muted dark:text-muted">Company</h2>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="/about" class="text-link hover:text-link-hover">About</a></li>
          </ul>
        </div>
        <div>
          <h2 class="text-caption-mono text-muted dark:text-muted">Legal</h2>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="/privacy-policy" class="text-link hover:text-link-hover">Privacy Policy</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-2 border-t border-hairline pt-8 text-xs text-muted sm:flex-row sm:items-center sm:justify-between dark:border-hairline dark:text-muted">
      <p>© {year} ScreenCheck. All rights reserved.</p>
      <p>Made with Astro & Tailwind CSS.</p>
    </div>
  </div>
</footer>